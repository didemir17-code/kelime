# ==========================================
# GEMINI API CONFIGURATION (SERVER-SIDE ONLY)
# ==========================================
# Google AI Studio API Key (https://aistudio.google.com/)
# ÖNEMLİ: Güvenlik açığı oluşmaması için kesinlikle NEXT_PUBLIC_ öneki KULLANILMAZ.
# Bu anahtar yalnızca sunucu tarafında (app/api/chat/route.ts) process.env.GEMINI_API_KEY olarak okunur.
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# DATABASE CONFIGURATION (POSTGRESQL / PRISMA)
# ==========================================
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# ==========================================
# AUTH / JWT CONFIGURATION
# ==========================================
JWT_SECRET="your-strong-jwt-secret-key"


